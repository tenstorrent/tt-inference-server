# Diagnostic P150x4 descriptor for QB2 hosts whose discovered fabric is a
# four-device path (degree histogram {1:2, 2:2}), not a four-device cycle.
# This behavioral-shadow topology does not qualify a Ring/2 package.

mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 4 ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 1 policy: RELAXED }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
