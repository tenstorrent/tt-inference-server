MODEL_RUNNER=tt-lab-gemma
MODEL_SERVICE=llm
MODEL_WEIGHTS_PATH=/home/ttuser/workspace/gemma31-reference
SERVED_MODEL_NAME=google/gemma-4-31B-it
VLLM={"model":"google/gemma-4-31B-it"}
DEVICE=p150
DEVICE_IDS=(0)
IS_GALAXY=false
MAX_MODEL_LENGTH=32768
MAX_QUEUE_SIZE=64
# Eight sequences: each request owns a cache slot (TT_GEMMA31_SLOTS), active requests decode
# together through tt-lab's exact batch-decode path, and the dynamic-batch device worker streams
# them concurrently. tt-lab runs 32-token prefill groups when slots > 1 (D64 needs one slot).
USE_DYNAMIC_BATCHER=true
MAX_BATCH_SIZE=8
MAX_NUM_SEQS=8
TT_GEMMA31_SLOTS=8
DOWNLOAD_WEIGHTS_FROM_SERVICE=false
REQUEST_PROCESSING_TIMEOUT_SECONDS=7200
WEIGHTS_DISTRIBUTION_TIMEOUT_SECONDS=1800
CANARY_ENABLED=true
CANARY_GATE_READINESS=true
CANARY_DEEP_PROBE_ENABLED=false
ENABLE_TELEMETRY=false
CHAT_TEMPLATE_KWARGS={"enable_thinking":false}
# tt-lab work/gemma31-qb2-serve 03f582c (work/gemma31-qb2 b3ad565 plus the --serve-batch front end),
# SHA-256 bc37a25a. One worker owns all four cards; the native worker opens them itself.
TT_LAB_BINARY=/home/ttuser/workspace/bringup-logs-gemma31/tt-lab-serve-03f582cf
TT_LAB_GGUF=/home/ttuser/models/gemma4-31b.bf16.gguf
TT_LAB_TTQ=/home/ttuser/models/gemma4-31b-all-bfp8.ttq
TT_LAB_CONTEXT=32768
HF_HOME=/home/ttuser/.cache/huggingface
NO_AUTH=true
HF_HUB_OFFLINE=true
TRANSFORMERS_OFFLINE=true
HTTP_HOST=127.0.0.1
HTTP_PORT=8002
WORKER_CHECK_SLEEP_TIMEOUT=5
# The QB2 kernel environment (tt-lab docs/gemma31-evidence/layout-cache-sustained.json plus the
# accepted QB2 options), with 8-bit K/V at every context: the configuration behind the CLI numbers.
TT_GEMMA31_ASYNC_PREPARE=1
TT_GEMMA31_ATTENTION_READ_BLOCKS=8
TT_GEMMA31_BATCH_GATHER=1
TT_GEMMA31_CACHE_WORDS=1
TT_GEMMA31_GROUP_CACHE=1
TT_GEMMA31_KV_BFP8=1
TT_GEMMA31_LEADER_BARRIER=1
TT_GEMMA31_MATRIX_DECODE=1
TT_GEMMA31_MATRIX_ONLY=1
TT_GEMMA31_MATRIX_PREFILL=1
TT_GEMMA31_OWNED_STATE=1
TT_GEMMA31_PACKED_ATTENDED=1
TT_GEMMA31_PACKED_DECODE_HIDDEN=1
TT_GEMMA31_PACKED_HIDDEN=1
TT_GEMMA31_PAIRED_DECODE=1
TT_GEMMA31_PAIRED_PREPARE=1
TT_GEMMA31_PARALLEL_LAYOUT=1
TT_GEMMA31_PIPELINE_CACHE=1
TT_GEMMA31_PREFILL=1
TT_GEMMA31_PREFILL_TOKENS=32
TT_GEMMA31_REGISTER_SOFTMAX=1
TT_GEMMA31_REUSE_SCALAR_INPUT=1
TT_GEMMA31_REUSE_WEIGHTS=1
TT_GEMMA31_SCATTER_INPUT=1
TT_GEMMA31_SOFTMAX_SCALE_PACK=1
TT_GEMMA31_SPLIT_ATTENTION=1
TT_GEMMA31_STREAM_WEIGHTS=1
TT_GEMMA31_WIDE_EXCHANGE=1
TT_GEMMA31_WIDE_REUSE=1
TT_GEMMA31_WORKERS=64
TT_GEMMA_PREFIX_CACHE=1
