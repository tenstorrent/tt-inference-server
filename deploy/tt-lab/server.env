MODEL_RUNNER=tt-lab-gpt-oss
MODEL_SERVICE=llm
MODEL_WEIGHTS_PATH=/home/ttuser/models/gpt-oss-20b-tokenizer
SERVED_MODEL_NAME=openai/gpt-oss-20b
VLLM={"model":"openai/gpt-oss-20b"}
DEVICE=p150
DEVICE_IDS=(0)
IS_GALAXY=false
USE_DYNAMIC_BATCHER=false
MAX_BATCH_SIZE=1
MAX_NUM_SEQS=1
MAX_MODEL_LENGTH=4096
MAX_QUEUE_SIZE=8
DOWNLOAD_WEIGHTS_FROM_SERVICE=false
REQUEST_PROCESSING_TIMEOUT_SECONDS=1800
WEIGHTS_DISTRIBUTION_TIMEOUT_SECONDS=1800
CANARY_ENABLED=true
CANARY_GATE_READINESS=true
CANARY_DEEP_PROBE_ENABLED=false
ENABLE_TELEMETRY=false
CHAT_TEMPLATE_KWARGS={"reasoning_effort":"low"}
TT_LAB_BINARY=/home/ttuser/workspace/tt-lab/_out/tt-lab
TT_LAB_GGUF=/home/ttuser/models/gpt-oss-20b-MXFP4.gguf
TT_LAB_TTQ=/home/ttuser/models/gpt-oss-20b.ttq
TT_LAB_HUGEPAGE_DIR=/dev/hugepages/ttlab
HF_HOME=/home/ttuser/.cache/huggingface
NO_AUTH=true
HF_HUB_OFFLINE=true
TRANSFORMERS_OFFLINE=true
HTTP_HOST=0.0.0.0
TT_LAB_DEVICE=0
TT_LAB_SINGLE_CHIP32=1
TT_LAB_BATCH_PREFILL=1
TT_LAB_BATCH_DENSE=1
TT_LAB_PREFILL_PAIR_ONLY=1
TT_LAB_PREFILL_CHUNK=128

WORKER_CHECK_SLEEP_TIMEOUT=5
