        }
      ]
    },
    {
      "models": [
        "qwen3_32b",
        "llama_3_1_8b",
        "llama_3_2_1b",
        "llama_70b_family",
        "gpt_oss_20b"
      ],
      "devices": [
        "n150",
        "n300",
        "t3k",
        "galaxy",
        "blackhole_galaxy",
        "galaxy_t3k",
        "gpu",
        "p100",
        "p150",
