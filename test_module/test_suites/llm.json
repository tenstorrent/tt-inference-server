        "openai/gpt-oss-120b"
      ],
      "test_cases": [
        {
          "enabled": true,
          "template": "VLLMParamConformanceTest"
        }
      ]
    },
    {
      "devices": [
        "p300x2"
      ],
      "impls": [
        "quetzal"
      ],
      "models": [
        "Qwen/Qwen3.8-27B"
      ],
      "test_cases": [
        {
          "enabled": true,
          "template": "VLLMParamConformanceTest",
          "test_config": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        }
      ]
    },
    {
      "models": [
        "qwen3_32b",
        "llama_3_1_8b",
        "llama_3_2_1b",
        "llama_70b_family",
        "gpt_oss_20b"
      ],
      "_exclude_impls_note": "quetzal rows get their own generated VLLMParamConformanceTest matrix (with their chat_template_kwargs), so this generic one must not also apply to them",
      "exclude_impls": [
        "quetzal"
      ],
      "devices": [
        "n150",
        "n300",
        "t3k",
        "galaxy",
        "blackhole_galaxy",
        "galaxy_t3k",
        "gpu",
        "p100",
        "p150",
        "p150x4",
        "p150x8",
        "p300",
        "p300x2"
      ],
      "test_cases": [
        {
          "template": "VLLMParamConformanceTest",
          "enabled": true,
          "description": "vLLM chat/completions parameter conformance"
        }
      ]
    },
    {
      "models": [
        "gemma4_31b",
        "gemma4_12b"
      ],
      "exclude_impls": [
        "quetzal"
      ],
      "devices": [
        "p300x2",
        "p150x8",
        "blackhole_galaxy"
      ],
      "test_cases": [
        {
          "template": "VLLMParamConformanceTest",
          "enabled": true,
          "description": "vLLM chat/completions parameter conformance (thinking off per request)",
          "_comment": "The checks read message.content; the Gemma 4 template's thought channel (enable_thinking) would consume the small token budgets. The kwargs are passed verbatim as --chat-template-kwargs, so a model with a different switch states its own.",
          "test_config": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        }
      ]
    },
    {
      "models": [
        "gpt_oss_20b"
      ],
      "devices": [
        "t3k",
        "galaxy",
        "galaxy_t3k"
      ],
      "test_cases": [
        {
          "template": "VLLMResponsesParamConformanceTest",
          "enabled": true,
          "description": "vLLM responses parameter conformance"
        }
      ]
    },
    {
      "models": [
