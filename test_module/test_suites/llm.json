        {
          "template": "ToolCallSchemaConformanceTest",
          "enabled": true,
          "description": "Tool-call arguments validate against walle JSON Schemas, tool_choice auto (pass rate >= 98.79%)",
          "_comment_threshold": "pass_rate_threshold = mean - 3 sample std of 10 runs on GPU vLLM (all 408 cases, no retries, 2026-10-05): 99.66% - 3 x 0.29% = 98.79%, i.e. at least 404 of 408.",
          "targets": {
            "pass_rate_threshold": 0.9879
          }
        },
        {
          "template": "ToolCallSchemaConformanceTest",
          "enabled": true,
