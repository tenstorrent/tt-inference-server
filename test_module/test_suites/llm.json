          "enabled": true,
          "description": "Qwen3-32B streaming reasoning/tool-call regressions"
        }
      ]
    },
    {
      "models": [
        "diffusiongemma_26b"
      ],
      "devices": [
        "p300x2"
      ],
      "test_cases": [
        {
          "template": "VLLMDiffusionGemmaParamConformanceTest",
          "enabled": true,
          "description": "DiffusionGemma block-serving and request-admission gates"
        }
      ]
    },
    {
      "models": [
        "minimax_m3"
      ],
      "devices": [
        "super_cluster"
      ],
      "test_cases": [
        {
          "template": "ToolCallSchemaConformanceTest",
          "enabled": true,
          "description": "Tool-call arguments validate against walle JSON Schemas, tool_choice auto (pass rate >= 98.08%; $ref schemas excluded, MiniMax parser bug)",
          "_comment": "exclude_ref_schemas: MiniMax tool calls are XML, so the server converts every text value to the schema's type, but the MiniMax parsers in ai-dynamo 1.3.0 (dynamo-parsers 5.0.0) and vLLM 0.30.0 never follow $ref -> $defs: 3 comes back as \"3\", an array as {\"item\": [...]}. Upstream, GPU vLLM returns the same; drop the exclusion once the parsers resolve $ref.",
          "_comment_threshold": "pass_rate_threshold = mean - 3 sample std of 10 runs on GPU vLLM ($ref excluded, no retries, 2026-10-05): 99.14% - 3 x 0.35% = 98.08%, i.e. at least 332 of 338.",
          "test_config": {
            "exclude_ref_schemas": true
          },
          "targets": {
            "pass_rate_threshold": 0.9808
          }
        },
        {
          "template": "ToolCallSchemaConformanceTest",
          "enabled": true,
          "description": "Tool-call arguments validate against walle JSON Schemas, tool_choice required, non-blocking ($ref schemas excluded, MiniMax parser bug)",
          "_comment": "Second run of the suite with tool_choice required; $ref schemas excluded for the reason given on the case above.",
          "test_config": {
            "exclude_ref_schemas": true,
            "tool_choice": "required",
            "non_blocking": true,
            "non_blocking_reason": "the tool_choice=required run is informational: reported, never blocking"
          }
        },
        {
          "template": "MiniMaxProviderVerifierTest",
          "enabled": true,
          "description": "MiniMax Provider Verifier verify.py: tool-call metrics on 102 agentic replays vs the verifier README thresholds",
          "_comment": "The verifier is exported at MINIMAX_VERIFIER_COMMIT in workflows/workflow_venvs.py; graded by test_module/llm_tests/minimax_verifier_grading.py. Each metric defaults to the verifier README threshold (calibrated on pass@10 means, graded here on one run); targets.<metric key> overrides it. verify_baseline is the official deployment's results for ToolCalls-Trigger-Similarity and must be in MINIMAX_VERIFIER_PATHS.",
          "_comment_threshold": "For now every metric uses the verifier README threshold (no targets). Measured on GPU vLLM, 10 verify.py runs (102 cases, concurrency 20, verifier 87c03f2, 2026-10-08; its verify.py, validator/ and sample.jsonl are identical to the pinned 4e778f7), mean - 3 sample std would give: ToolCalls-Match-Rate 96.70% - 3 x 0.82% = 94.23% (README 97%), i.e. at least 95 of 100 labelled cases; ToolCalls-Trigger-Similarity 98.61% - 3 x 0.50% = 97.10% (README 98%); ToolCalls-Schema-Accuracy 98.65% - 3 x 0.38% = 97.50% (README 98%), i.e. at most 2 invalid of ~82 tool calls. To grade against these instead, set targets {tool_calls_match_rate: 0.9423, tool_calls_trigger_similarity: 0.971, tool_calls_schema_accuracy: 0.975}. Scenario-Check-Pass-Rate keeps the README's 100% but is advisory (advisory_metrics): it is graded and shown against 100% and never fails the run, because it is one case and GPU vLLM failed it in 2 of the 10 runs.",
          "test_config": {
            "suite": "verify",
            "verify_baseline": "output-dir/MiniMax-M3/loop_01",
            "advisory_metrics": ["scenario_check_pass_rate"]
          }
        },
        {
          "template": "MiniMaxProviderVerifierTest",
          "enabled": true,
          "description": "MiniMax Provider Verifier m3_format_check text: chat-completions contract, non-blocking",
          "test_config": {
            "suite": "text",
            "non_blocking": true,
            "non_blocking_reason": "MiniMax format-check suites are informational until they pass cleanly"
          }
        },
        {
          "template": "MiniMaxProviderVerifierTest",
          "enabled": true,
          "description": "MiniMax Provider Verifier m3_format_check stream: SSE protocol and packet-length distribution, non-blocking",
          "test_config": {
            "suite": "stream",
            "non_blocking": true,
            "non_blocking_reason": "MiniMax format-check suites are informational until they pass cleanly"
          }
        },
        {
          "template": "MiniMaxProviderVerifierTest",
          "enabled": true,
          "description": "MiniMax Provider Verifier m3_format_check image: image input, non-blocking",
          "test_config": {
            "suite": "image",
            "non_blocking": true,
            "non_blocking_reason": "MiniMax format-check suites are informational until they pass cleanly"
          }
        },
        {
          "template": "MiniMaxProviderVerifierTest",
          "enabled": true,
          "description": "MiniMax Provider Verifier m3_format_check video: video input, non-blocking",
          "test_config": {
            "suite": "video",
            "non_blocking": true,
            "non_blocking_reason": "MiniMax format-check suites are informational until they pass cleanly"
          }
        }
      ]
    },
    {
      "models": [
        "minimax_m2_7"
      ],
      "devices": [
