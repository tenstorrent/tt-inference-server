  "description": "TTS server (MODEL_SERVICE=tts) \u2014 codec-token decode throughput per device, replica, voice source and model, plus TTS worker health. Codec-token throughput measures autoregressive decode capacity and predicts whether speech generation can stay ahead of playback.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": [
    "tenstorrent",
    "inference",
    "tts",
    "audio"
  ],
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "type": "query",
        "query": {
          "query": "label_values(tt_tts_codec_tokens_total, device)",
          "refId": "device"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "voice_source",
        "label": "Voice source",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "type": "query",
        "query": {
          "query": "label_values(tt_tts_codec_tokens_total, voice_source)",
          "refId": "voice_source"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "TT Media Server \u2014 TTS (codec decode)",
  "uid": "tt-media-server-tts",
  "version": 1,
  "panels": [
    {
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Codec-Token Throughput",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Acoustic/codec tokens generated per second across every device and replica in the current filter. This is the autoregressive decode capacity of the TTS model.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 25
              }
            ]
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(tt_tts_codec_tokens_total{device=~\"$device\", voice_source=~\"$voice_source\"}[$__rate_interval]))",
          "legendFormat": "Codec Tokens/s",
          "refId": "A"
        }
      ],
      "title": "Codec Tokens/s",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Highest per-device codec-token rate. A large gap between this and the per-device average means work is unevenly spread across devices.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(sum by (device) (rate(tt_tts_codec_tokens_total{device=~\"$device\", voice_source=~\"$voice_source\"}[$__rate_interval])))",
          "legendFormat": "Busiest Device",
          "refId": "A"
        }
      ],
      "title": "Busiest Device",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Total acoustic tokens emitted since the workers last (re)started. Drops to zero on a worker restart.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(tt_tts_codec_tokens_total{device=~\"$device\", voice_source=~\"$voice_source\"})",
          "legendFormat": "Codec Tokens (cumulative)",
          "refId": "A"
        }
      ],
      "title": "Codec Tokens (cumulative)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "TTS worker processes currently running (one per DEVICE_IDS group).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(tt_worker_alive)",
          "legendFormat": "Workers Alive",
          "refId": "A"
        }
      ],
      "title": "Workers Alive",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Per-device codec-token throughput. `device` is the worker's DEVICE_IDS group (its TT_VISIBLE_DEVICES value). Watch for one device falling behind the others \u2014 it caps the whole replica's concurrency.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 6,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device) (rate(tt_tts_codec_tokens_total{device=~\"$device\", voice_source=~\"$voice_source\"}[$__rate_interval]))",
          "legendFormat": "device {{device}}",
          "refId": "A"
        }
      ],
      "title": "Codec Tokens/s by Device",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Throughput split by how the voice was specified: `default` (no prompt), `description` (free-form voice prompt) or `voice_sample` (cloned from an uploaded WAV). The TTS API exposes no voice ID or language field, so this is the finest voice granularity available today \u2014 per-voice and per-language breakdowns need those fields added to the request first.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 7,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (voice_source) (rate(tt_tts_codec_tokens_total{device=~\"$device\", voice_source=~\"$voice_source\"}[$__rate_interval]))",
          "legendFormat": "{{voice_source}}",
          "refId": "A"
        }
      ],
      "title": "Codec Tokens/s by Voice Source",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Per-replica throughput. `instance` is the Prometheus scrape target \u2014 one series per server replica, summed over that replica's devices.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 8,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(tt_tts_codec_tokens_total{device=~\"$device\", voice_source=~\"$voice_source\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Codec Tokens/s by Replica",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Full granularity in one view: codec tokens/s broken out by model, device, replica and voice source. Empty rows mean that combination produced no tokens in the window.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 9,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (model_name, instance, device, voice_source) (rate(tt_tts_codec_tokens_total{device=~\"$device\", voice_source=~\"$voice_source\"}[$__rate_interval]))",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "title": "Codec Tokens/s by Model / Replica / Device / Voice Source",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "type": "table"
    },
    {
