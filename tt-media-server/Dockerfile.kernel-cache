# Adds a captured tt-metal kernel cache to an existing tt-media-server image, so
# a server start loads the compiled kernels instead of compiling them.
#
# Build context (staged by scripts/prebuilt_artifacts.py kernel-cache build-image):
#   kernel_cache/                cache tree captured with run.py --kernel-cache-dir
#   kernel_cache_manifest.json   output of kernel-cache manifest
#
# tt-metal reuses a kernel cache only at the absolute path it was written at, so
# the tree goes to the capture path and TT_METAL_CACHE points there. tt-metal
# writes into the cache on every start, so the tree is writable for any uid a
# deployment runs the server as. User, entrypoint and cmd come from the base image.
#
# Build (needs BuildKit for COPY --chmod):
#   docker build -f Dockerfile.kernel-cache --build-arg BASE_IMAGE=<image> -t <tag> <context>

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

COPY --chmod=777 kernel_cache/ /home/container_app_user/tt_metal_kernel_cache/
# tt-metal adds one folder per build key, so the top directory is writable too.
RUN chmod 777 /home/container_app_user/tt_metal_kernel_cache
COPY --chmod=644 kernel_cache_manifest.json /home/container_app_user/kernel_cache_manifest.json

ENV TT_METAL_CACHE=/home/container_app_user/tt_metal_kernel_cache
