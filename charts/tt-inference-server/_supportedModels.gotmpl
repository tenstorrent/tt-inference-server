{{- /*
chart.supportedModelsSection — auto-generated Supported Models tables.

Reads values.yaml via .Files.Get and walks the model catalogue, whose shape is
`models.<name>.<engine>.<device>` alongside a sibling `defaultEngine` string.
Models are grouped by engine — the top-level key under each model, excluding
`defaultEngine` — and one Markdown table is emitted per engine, listing every
model/device pair. The label is derived from the engine key (vllm → vLLM,
media → Media, forge → Forge); any unmapped engine falls back to its
capitalised key.

Adding a new engine, model, or device in values.yaml is reflected here on the
next helm-docs run — no manual edit to this file or README.md.gotmpl.
*/ -}}
{{- define "chart.supportedModelsSection" -}}
{{- $values := .Files.Get "values.yaml" | fromYaml -}}
{{- $labels := dict "vllm" "vLLM" "media" "Media" "forge" "Forge" -}}
{{- $engineOrder := list "vllm" "media" "forge" -}}
{{- /* Deployable device shapes: those with a DRA board count, plus the non-TT
       passthrough devices. Others (e.g. galaxy_t3k) fail at render, so exclude
       them from the catalogue. */ -}}
{{- $supported := concat (keys (default (dict) $values.deviceBoardCounts)) (list "gpu" "cpu") -}}
{{- /* Rows whose pinned image predates the engine's floor are refused at render
       too, so they are left out the same way. Only vllm is gated outright: the
       media/forge floor applies to auth.disabled, not to installing the row. */ -}}
{{- $floors := default (dict) $values.imageFloor -}}
{{- $groups := dict -}}
{{- range $name, $cfg := $values.models -}}
  {{- range $engine, $devices := $cfg -}}
  {{- if ne $engine "defaultEngine" -}}
    {{- $entries := default (list) (index $groups $engine) -}}
    {{- $_ := set $groups $engine (append $entries (dict "name" $name "devices" $devices)) -}}
  {{- end -}}
  {{- end -}}
{{- end -}}
## Supported Models
{{- range $engineOrder }}
{{- $engine := . }}
{{- if hasKey $groups $engine }}
{{- $floor := ternary (dig "vllm" "" $floors) "" (eq $engine "vllm") }}

### {{ index $labels $engine | default ($engine | title) }}

| Model | Devices |
|---|---|
{{- $omitted := 0 }}
{{- range (index $groups $engine) }}
{{- $name := .name }}
{{- $devs := list }}
{{- range $device, $dcfg := .devices }}
{{- if has $device $supported }}
{{- if $floor }}
{{- $ok := dict "v" false }}
{{- range $impl, $icfg := (default (dict) $dcfg.impls) }}
{{- $rel := regexFind "^[0-9]+\\.[0-9]+\\.[0-9]+" (toString $icfg.image.tag) }}
{{- if or (not $rel) (semverCompare (printf ">=%s" $floor) $rel) }}{{- $_ := set $ok "v" true }}{{- end }}
{{- end }}
{{- if $ok.v }}{{- $devs = append $devs $device }}{{- else }}{{- $omitted = add1 $omitted }}{{- end }}
{{- else }}
{{- $devs = append $devs $device }}
{{- end }}
{{- end }}
{{- end }}
{{- if $devs }}
| `{{ $name }}` | {{ $devs | sortAlpha | join ", " }} |
{{- end }}
{{- end }}
{{- if $omitted }}

> {{ $omitted }} model/device rows are left out: their pinned image predates the
> {{ $floor }} floor for this engine, so the chart refuses them at render. See
> [Supported Image Releases](#supported-image-releases).
{{- end }}
{{- end }}
{{- end }}
{{- range $engine, $entries := $groups }}
{{- if not (has $engine $engineOrder) }}

### {{ index $labels $engine | default ($engine | title) }}

| Model | Devices |
|---|---|
{{- range $entries }}
{{- $name := .name }}
{{- $devs := list }}
{{- range $device, $_ := .devices }}{{- if has $device $supported }}{{- $devs = append $devs $device }}{{- end }}{{- end }}
{{- if $devs }}
| `{{ $name }}` | {{ $devs | sortAlpha | join ", " }} |
{{- end }}
{{- end }}
{{- end }}
{{- end }}

To add a new model, add an entry under `models.<name>.<engine>.<device>` in `values.yaml`, where `<engine>` is one of `vllm`, `media`, or `forge`, and the device block contains an `impls.<impl-id>` entry with `image.repository` and `image.tag`.
{{- end -}}
