{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "title": "tt-inference-server \u2014 vLLM",
  "uid": "ttis-vllm",
  "description": "Application metrics for the tt-inference-server vLLM engine. Panels use only the vLLM engine-core metric families, so they hold across the vLLM versions the model catalogue pins. vLLM upstream also publishes a richer dashboard that can be imported alongside this one.",
  "tags": [
    "tenstorrent",
    "tt-inference-server"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "job",
        "label": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "allValue": ".*",
        "query": {
          "query": "label_values(vllm:num_requests_running, job)",
          "refId": "job"
        },
        "definition": "label_values(vllm:num_requests_running, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "allValue": ".*",
        "query": {
          "query": "label_values(vllm:num_requests_running, pod)",
          "refId": "pod"
        },
        "definition": "label_values(vllm:num_requests_running, pod)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "model_name",
        "label": "model_name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "allValue": ".*",
        "query": {
          "query": "label_values(vllm:num_requests_running, model_name)",
          "refId": "model_name"
        },
        "definition": "label_values(vllm:num_requests_running, model_name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
