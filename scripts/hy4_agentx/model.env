# Model constants of the Hy4-Preview harness (single source of truth: sourced by the shell scripts, parsed by harness_model.py).
# Plain KEY=VALUE lines, no quoting, no expansion. A different model = a different file, selected with HARNESS_MODEL_ENV=<path>.
HARNESS_MODEL_ID=tencent/Hy4-preview
HARNESS_MODEL_NAME=Hy4-preview
HARNESS_DEVICE=blackhole_galaxy
HARNESS_IMPL_ID_PREFIX=hy4_preview_b
HARNESS_IMPL_NAME_PREFIX=hy4-preview-b
HARNESS_BATCH_SIZES=4,8
HARNESS_MAX_CTX=1048576
HARNESS_CKPT_DIR=/mnt/tt-data/Hy4-Preview
HARNESS_THINK_KEY=reasoning_effort
HARNESS_THINK_ON=high
HARNESS_THINK_OFF=no_think
HARNESS_TEMPERATURE=0.9
HARNESS_TOP_P=1.0
HARNESS_SEED=42
HARNESS_TRACE_DATASET=semianalysisai/cc-traces-weka-062126
HARNESS_CATALOG=/home/container_app_user/model_specs/model_spec.json
