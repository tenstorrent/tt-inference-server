+    def _store_history_workspace(self, state, key, histories):
+        import time
+        started = time.perf_counter()
+        if not state.history_workspace:
+            return histories
+        if key not in state.history_leases:
+            if not state.history_free:
+                raise RuntimeError("Live history keys exceed fixed serving slot capacity")
+            state.history_leases[key] = state.history_free.pop()
+        bank = state.history_workspace[state.history_leases[key]]
+        if len(histories) != len(bank):
+            raise ValueError("History layer count must match workspace")
+        saved = []
+        for layer_index, tails in enumerate(histories):
+            if tails is None:
+                saved.append(None)
+                continue
+            pair = []
+            for component, tail in enumerate(tails):
+                owner = bank[layer_index][component]
+                expected = [1, owner.shape[1], tail.shape[2], owner.shape[3]]
+                padded = [1, owner.shape[1], (tail.shape[2] + 31) // 32 * 32, owner.shape[3]]
+                if not 1 <= tail.shape[2] <= owner.shape[2] or list(tail.shape) != expected:
+                    raise ValueError("History has unexpected geometry")
+                if list(tail.padded_shape) != padded or tail.dtype != ttnn.bfloat16 or tail.layout != ttnn.TILE_LAYOUT:
+                    raise ValueError("History must be compact tiled BF16")
+                if tail.buffer_unique_id() == owner.buffer_unique_id():
+                    raise RuntimeError("Workspace overwrite source must be an independent completed tail")
+                view = ttnn.reshape(owner, ttnn.Shape(list(tail.shape)), ttnn.Shape(list(tail.padded_shape)))
+                if view.buffer_unique_id() != owner.buffer_unique_id():
+                    raise RuntimeError("History view must retain its pre-capture allocation")
+                # Rewrite the complete compact volume; old contents have different
+                # per-head strides when the history length changes.
+                ttnn.copy(tail, view)
+                pair.append(view)
+            saved.append(tuple(pair))
+        logger.info("HISTORY_COPY_TIMING " + json.dumps({"wall_s":time.perf_counter()-started}))
+        return saved
 
