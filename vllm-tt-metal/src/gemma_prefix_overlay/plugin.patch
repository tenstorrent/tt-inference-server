+    def _prefill_formation_should_wait(self, has_running_decode: bool) -> bool:
+        """Bound optional admission delay while useful decode can run.
+
+        This never allocates pages, changes queue order, estimates cache hits,
+        delays a running partial prefill, or overrides a forced lane mode.
+        Oldest eligible age is a formation clock, not counterfactual added
+        request latency. Actual queue/TTFT are measured by the normal API trace.
+        """
+        maximum_wait = getattr(self, "_prefill_formation_wait_s", 0)
+        if maximum_wait == 0:
+            return False
+        waiting = list(self.waiting)
+        alive = {request.request_id for request in waiting}
+        first = self._prefill_formation_first
+        for request_id in list(first):
+            if request_id not in alive:
+                del first[request_id]
+        # Let native scheduling promote blocked dependencies and handle resumed
+        # or stale-output requests without introducing another delay policy.
+        if (
+            not waiting
+            or not has_running_decode
+            or self._forced_mode != TTSchedulingMode.DEFAULT
+            or self._pause_state != PauseState.UNPAUSED
+            or getattr(self, "skipped_waiting", False)
+            or any(request.is_prefill_chunk for request in self.running)
+            or any(
+                request.status != RequestStatus.WAITING
+                or request.num_computed_tokens != 0
+                or request.num_output_placeholders != 0
+                or getattr(request, "num_stale_output_tokens", 0) != 0
+                for request in waiting
+            )
+        ):
+            return False
+        free = self.max_num_running_reqs - len(self.running) - self.num_waiting_for_streaming_input
+        if free <= 0:
+            # Native capacity blocking is not an intentional formation wait.
+            return False
+        target = min(self._prefill_formation_target, self.max_num_running_reqs)
+        if len(waiting) + len(self.running) < target:
+            # Observed small tail cannot populate the desired group from its
+            # current participants. Do not wait for hypothetical new actors.
+            return False
+        # Start each clock only when its FCFS row fits currently free request
+        # slots. Rows behind that prefix are still capacity-blocked, even when
+        # an earlier row has a slot. This does not predict KV/token admission.
+        eligible = waiting[:free]
+        now = time.monotonic()
+        for request in eligible:
+            first.setdefault(request.request_id, now)
+        age = now - min(first[request.request_id] for request in eligible)
+        feasible = len(eligible)
+        reason = "target" if feasible >= target else "deadline" if age >= maximum_wait else "wait"
+        logger.info("GEMMA_PREFILL_FORMATION %s", json.dumps({
+            "wall_s": time.time(), "mono_s": now, "reason": reason,
+            "request_ids": [request.request_id for request in eligible],
+            "clock_scope": "first_capacity_feasible_fcfs_prefix",
+            "ready": len(waiting), "free_slots": free, "target": target,
+            "feasible_rows": feasible, "oldest_eligible_age_s": age,
+            "maximum_wait_s": maximum_wait,
+        }))
+        return reason == "wait"
