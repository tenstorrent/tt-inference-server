+/// Whether VLLM_ROUTER_MEDIA_PLACEHOLDERS=1 (read once).
+fn media_placeholders_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("VLLM_ROUTER_MEDIA_PLACEHOLDERS").is_ok_and(|v| v == "1"))
+}
+
+/// The routing key of one media part: its URL (or data URL) when it has one, else the part itself, hashed.
+fn media_part_key(part: &serde_json::Value) -> String {
+    use sha2::{Digest, Sha256};
+    let kind = part.get("type").and_then(serde_json::Value::as_str).unwrap_or("");
+    let source = part
+        .get(kind)
+        .and_then(|inner| inner.get("url").or(Some(inner)))
+        .and_then(serde_json::Value::as_str)
+        .map(str::to_owned)
+        .unwrap_or_else(|| part.to_string());
+    let digest = Sha256::digest(source.as_bytes());
+    let hex: String = digest[..8].iter().map(|b| format!("{b:02x}")).collect();
+    format!("<|media:{kind}:{hex}|>")
+}
+
+/// For prefix routing of chats with media (enabled by VLLM_ROUTER_MEDIA_PLACEHOLDERS=1): a copy of `body` whose
+/// non-text content parts are text parts naming a hash of their URL, so the worker renders it as text (no media fetch
+/// or encode) and the same media gives the same ids in every turn and on every worker. None when disabled, not a
+/// chat, or without media parts. Only the routing key changes; the generation request is untouched.
+fn media_placeholders(body: &serde_json::Value, route: &str) -> Option<serde_json::Value> {
+    if route != "/v1/chat/completions" || !media_placeholders_enabled() {
+        return None;
+    }
+    let messages = body.get("messages")?.as_array()?;
+    let is_media = |part: &serde_json::Value| part.get("type").and_then(serde_json::Value::as_str) != Some("text");
+    if !messages.iter().any(|m| {
+        m.get("content")
+            .and_then(serde_json::Value::as_array)
+            .is_some_and(|parts| parts.iter().any(is_media))
+    }) {
+        return None;
+    }
+    let mut out = body.clone();
+    for message in out.get_mut("messages")?.as_array_mut()? {
+        if let Some(parts) = message.get_mut("content").and_then(serde_json::Value::as_array_mut) {
+            for part in parts.iter_mut() {
+                if is_media(part) {
+                    *part = serde_json::json!({"type": "text", "text": media_part_key(part)});
+                }
+            }
+        }
+    }
+    Some(out)
+}
