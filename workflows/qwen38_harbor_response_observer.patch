 class LiteLLM(BaseLLM):
+    # Candidate opt-in host diagnostics. Never forwarded to the provider.
+    supports_raw_response_observer = True
+
+    def _observe_raw_response(self, response):
+        observer = getattr(self, '_raw_response_observer', None)
+        if observer is None:
+            return
+        try:
+            choice = response['choices'][0]
+            message = choice['message']
+            usage = response.get('usage') or {}
+            observer({
+                'finish_reason': choice.get('finish_reason'),
+                'usage': {name: usage.get(name) for name in
