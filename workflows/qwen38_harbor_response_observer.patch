+                'content': message.get('content'),
+                'reasoning_content': message.get('reasoning_content'),
+            })
+        except Exception as error:
+            try:
+                self._logger.warning('Raw response diagnostic unavailable: %s', type(error).__name__)
+            except Exception:
+                pass
+
