--- a/tests/unit/controller/test_multiprocess_service_manager.py
+++ b/tests/unit/controller/test_multiprocess_service_manager.py
@@ -298,6 +298,77 @@ class TestMultiProcessServiceManager:
                 stop_event=asyncio.Event(), timeout_seconds=1.0
             )
 
+    @pytest.mark.asyncio
+    async def test_wait_blocks_until_every_replica_registers(
+        self, service_manager: MultiProcessServiceManager, mock_alive_process: MagicMock
+    ):
+        """Regression: with several replicas of one service type, the wait must
+        cover every replica, not the first one to register.
+
+        Failure mode: --record-processor-service-count 8 spawns eight
+        RecordProcessors at startup. The wait used to compare service *types*,
+        so the first RecordProcessor to register satisfied it and the controller
+        broadcast ProfileConfigureCommand and DatasetConfiguredNotification while
+        the other replicas were still starting. Those replicas never got
+        configured, blocked on their records and aborted at the dataset gate,
+        and their records were lost.
+        """
+        from aiperf.common.enums import ServiceRegistrationStatus
+        from aiperf.common.models.service_models import ServiceRunInfo
+
+        def spawned(service_type: ServiceType, service_id: str) -> MultiProcessRunInfo:
+            return MultiProcessRunInfo.model_construct(
+                process=mock_alive_process,
+                service_type=service_type,
+                service_id=service_id,
+            )
+
+        def registered(service_type: ServiceType, service_id: str) -> ServiceRunInfo:
+            return ServiceRunInfo(
+                service_type=service_type,
+                registration_status=ServiceRegistrationStatus.REGISTERED,
+                service_id=service_id,
+            )
+
+        service_manager.multi_process_info = [
+            spawned(ServiceType.DATASET_MANAGER, "dataset_manager"),
+            spawned(ServiceType.TIMING_MANAGER, "timing_manager"),
+        ] + [
+            spawned(ServiceType.RECORD_PROCESSOR, f"record_processor_{i}")
+            for i in range(3)
+        ]
+        service_manager.service_id_map = {
+            "dataset_manager": registered(
+                ServiceType.DATASET_MANAGER, "dataset_manager"
+            ),
+            "timing_manager": registered(ServiceType.TIMING_MANAGER, "timing_manager"),
+            "record_processor_0": registered(
+                ServiceType.RECORD_PROCESSOR, "record_processor_0"
+            ),
+        }
+
+        # One of three RecordProcessors registered: the type is present, but the
+        # wait must not return.
+        with pytest.raises(AIPerfError, match="failed to register within timeout"):
+            await service_manager.wait_for_all_services_registration(
+                stop_event=asyncio.Event(), timeout_seconds=1.0
+            )
+
+        # The remaining replicas register while the wait is running: it returns.
+        async def register_late() -> None:
+            await asyncio.sleep(0.6)
+            for i in (1, 2):
+                service_manager.service_id_map[f"record_processor_{i}"] = registered(
+                    ServiceType.RECORD_PROCESSOR, f"record_processor_{i}"
+                )
+
+        await asyncio.gather(
+            service_manager.wait_for_all_services_registration(
+                stop_event=asyncio.Event(), timeout_seconds=5.0
+            ),
+            register_late(),
+        )
+
     @pytest.mark.asyncio
     async def test_stop_event_cancels_registration_wait(
         self, service_manager: MultiProcessServiceManager, mock_alive_process: MagicMock
