+    @classmethod
+    def _pull_egress_control_kernel_probe_image(cls) -> None:
+        """Pull the kernel probe's image with retries unless it is present.
+
+        Failures are only logged: the probe then reports why it could not run.
+        """
+        image = cls._EGRESS_CONTROL_KERNEL_PROBE_IMAGE
+        try:
+            present = subprocess.run(
+                cls._engine_cmd("image", "inspect", image),
+                capture_output=True,
+                text=True,
+                timeout=60,
+            )
+            if present.returncode == 0:
+                return
+        except Exception:
+            pass
+        attempts = cls._EGRESS_CONTROL_KERNEL_PROBE_PULL_ATTEMPTS
+        timeout = cls._EGRESS_CONTROL_KERNEL_PROBE_PULL_TIMEOUT_SEC
+        for attempt in range(1, attempts + 1):
+            try:
+                result = subprocess.run(
+                    cls._engine_cmd("pull", image),
+                    capture_output=True,
+                    text=True,
+                    timeout=timeout,
+                )
+                if result.returncode == 0:
+                    return
+                detail = (result.stderr or result.stdout).strip()[-300:]
+            except subprocess.TimeoutExpired:
+                detail = f"timed out after {timeout}s"
+            except Exception as exc:
+                detail = f"{type(exc).__name__}: {exc}"
+            logger.warning(
+                "Pull of the egress-control kernel probe image %s failed "
+                "(attempt %d/%d): %s",
+                image,
+                attempt,
+                attempts,
+                detail,
+            )
+            if attempt < attempts:
+                time.sleep(min(60.0, 2.0**attempt))
