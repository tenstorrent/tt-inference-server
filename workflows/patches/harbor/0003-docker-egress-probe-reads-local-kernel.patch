+    @classmethod
+    def _local_egress_control_kernel_support(cls) -> bool | None:
+        """The kernel probe's answer read on this host, or None when the engine's
+        kernel is not this process's (a VM, a remote ``DOCKER_HOST``) or unknown."""
+        try:
